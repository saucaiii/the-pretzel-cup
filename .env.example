# Pretzel Cup — environment variables.
# Copy these to Vercel Project Settings → Environment Variables, or into
# .env.development.local for local dev. Never commit real values.
#
# Supabase + session (already in use pre-p11).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_JWT_SECRET=

# Google Sheets writer (optional — the stops writer uses it if present).
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
STOPS_SHEET_ID=

# Telegram broadcast + webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Operator contact — the store portal's Call/Text buttons link to this.
OPERATOR_PHONE=+1XXXXXXXXXX

# ───────────────────────────────────────────────────────────────
# Payment flow (p11_payment_flow — docs/payment-flow.md §Env vars).
# ───────────────────────────────────────────────────────────────

# Stripe keys. Use sk_test_… and pk_test_… until the smoke test passes;
# the Stripe dashboard webhook endpoint must be pointed at
# https://the-pretzel-cup.vercel.app/api/store?resource=stripe-webhook
# with STRIPE_WEBHOOK_SECRET copied from Stripe → Developers → Webhooks.
# The secret key should be a RESTRICTED key with Customers, PaymentMethods,
# SetupIntents, Invoices, PaymentIntents, Webhooks write access only.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Line-item unit prices sent to Stripe on invoice-item create. Mirrors the
# driver app's pricing. Rotate these without a schema migration.
STRIPE_SINGLE_PRICE_CENTS=215
STRIPE_DOUBLE_PRICE_CENTS=385

# Shared secret for the draft-generation cron (Vercel Cron → bearer header).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Auto-approval switch. 0 = operator manually approves every draft (default
# during initial rollout). 1 = auto-approve drafts that are below the
# variance threshold on the cutoff day (Wed 23:00 ET weekly, 5th 23:00 ET
# monthly — enforced inside the cron handler).
AUTO_APPROVE_ENABLED=0

# Threshold % away from the trailing 8-week average that lands a draft a
# "Review variance" chip. Draft > ±N% of the average is not auto-approvable.
VARIANCE_FLAG_PCT=25
