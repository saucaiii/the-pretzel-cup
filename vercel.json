{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/store/:slug([A-Za-z0-9]{2,32})", "destination": "/store/signin?slug=:slug" },
    { "source": "/arcade/api/:path*", "destination": "https://pretzels-fun.sauciii-win.workers.dev/api/:path*" }
  ],
  "redirects": [
    { "source": "/play", "destination": "/arcade", "permanent": false },
    { "source": "/fun", "destination": "/arcade", "permanent": false }
  ],
  "crons": [
    {
      "path": "/api/schedule?resource=generate-drafts",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/onboarding-kit/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/pitch-kit/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
